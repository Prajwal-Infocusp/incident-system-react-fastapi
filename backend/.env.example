# Database connection URL
# For local development outside of Docker, connect to localhost:5432:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_system
# For development inside Docker Compose, the database host is "postgres":
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/incident_system
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_system

# Individual Database Credentials (used by Docker Compose if DATABASE_URL is not overridden)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incident_system

# Secret Key for JWT Signing (Must be a secure random 32+ character string in production)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
