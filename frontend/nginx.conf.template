server {
    listen ${PORT};

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        resolver 8.8.8.8 1.1.1.1 127.0.0.11 valid=30s; # Works both on GCP (8.8.8.8) and locally (127.0.0.11)
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        proxy_ssl_server_name on; # REQUIRED for SSL SNI handshake to GCP Cloud Run
        proxy_set_header Host $proxy_host; # Pass the target backend domain to Google's Load Balancer
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
